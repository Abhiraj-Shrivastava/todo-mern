# Base URL of the deployed API (no trailing slash), used by production builds.
# Leave empty in development: Vite proxies /api to http://localhost:4000.
# Example: VITE_API_URL=https://todo-api.onrender.com
VITE_API_URL=

# Optional: where the dev server proxies /api (default http://localhost:4000)
# VITE_PROXY_TARGET=http://localhost:4000
