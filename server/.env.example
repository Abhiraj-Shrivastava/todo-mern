# Port the API listens on
PORT=4000

# MongoDB connection string (MongoDB 5.0 or newer).
# Local:  mongodb://127.0.0.1:27017/todo
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/todo?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/todo

# Comma-separated list of front-end origins allowed by CORS.
# Leave empty to allow any origin (fine for local development).
# Example for production: https://your-app.netlify.app
CLIENT_ORIGIN=
