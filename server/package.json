{
  "name": "todo-server",
  "version": "1.0.0",
  "description": "REST API for the To-Do List app (Express + MongoDB)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:memory": "node scripts/dev-memory.js",
